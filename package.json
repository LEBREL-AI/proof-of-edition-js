{
  "name": "lebrel-proof-of-edition",
  "version": "0.1.0",
  "description": "Verify Lebrel answers: signed serving manifests and per-answer receipts (Proof of Edition), for editions and routed models. The same checks as lebrel.ai/verify, in Node and browsers.",
  "license": "Apache-2.0",
  "author": "Lebrel",
  "homepage": "https://lebrel.ai/verify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LEBREL-AI/proof-of-edition-js.git"
  },
  "bugs": {
    "url": "https://github.com/LEBREL-AI/proof-of-edition-js/issues"
  },
  "keywords": [
    "lebrel",
    "proof-of-edition",
    "receipts",
    "ed25519",
    "llm",
    "verification",
    "inference"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
